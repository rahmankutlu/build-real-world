{
  "name": "build-real-world",
  "version": "0.1.1",
  "private": true,
  "description": "Production-grade system design case studies, architecture patterns, failure modes, database models, APIs, and scaling strategies.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/validate-export.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pages": "NEXT_PUBLIC_BASE_PATH=/build-real-world PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000/build-real-world/ npm run test:e2e",
    "validate": "tsx scripts/validate-content.ts && tsx scripts/validate-links.ts && tsx scripts/validate-seo.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/build-real-world NEXT_PUBLIC_SITE_URL=https://rahmankutlu.github.io/build-real-world npm run build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "lucide-react": "0.544.0",
    "mermaid": "11.17.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.6.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "27.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
